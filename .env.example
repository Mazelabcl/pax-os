# === API Keys necesarias para el proyecto Pax ===
# Copia este archivo a .env.local y completa con tus keys reales.
# .env.local esta en .gitignore — no se sube.

# OpenAI (gpt-image-2 via scripts/openai_images.py)
OPENAI_API_KEY=

# OpenRouter (Claude Haiku para el Oraculo)
OPENROUTER_API_KEY=

# Replicate (Seedance via scripts/seedance.py)
REPLICATE_API_TOKEN=

# Free Astrology API (cartas astrales del Oraculo)
FREE_ASTROLOGY_API_KEY=
