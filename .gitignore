# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# trabajo interno (voice notes + debates entre agentes)
feedback-pipez.txt
process-log/

# python cache + test images temporales
scripts/__pycache__/
scripts/test-apple.png
scripts/test-gpt-image-2.png

# backups locales pesados (movidos durante reorg 2026-05-21)
_archive/backups-comprimidos/

# imagenes generadas por API (paxearte / child-story)
public/generated/*
!public/generated/.gitkeep

